<Window x:Class="Budget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Budget"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid HorizontalAlignment="Left" Width="800">
        <TextBox x:Name="InputNavn" HorizontalAlignment="Left" Margin="248,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="152" TextInput="NavnInput"/>
        <ListBox x:Name="ListBoxIndtaegter" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="219,90,0,125" SelectionChanged="SelectionChanged_Indtaegter" HorizontalAlignment="Left" Width="174"/>
        <ListBox x:Name="ListBoxUdgifter" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="407,90,0,125" SelectionChanged="SelectionChanged_Udgifter" HorizontalAlignment="Left" Width="174"/>
        <TextBox x:Name="InputKroner" HorizontalAlignment="Left" Margin="400,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="151" TextInput="KronerInput"/>
        <Button x:Name="ButtonIndtaegter" Content="Tilføj til indtægter" HorizontalAlignment="Left" Margin="247,66,0,0" VerticalAlignment="Top" Height="19" Width="118" Click="TilføjTilIndtaegter"/>
        <Button x:Name="ButtonUdgifter" Content="Tilføj til Udgifter" HorizontalAlignment="Left" Margin="435,67,0,0" VerticalAlignment="Top" Height="18" Width="118" Click="TilføjTilUdgifter"/>
        <Button x:Name="ButtonUdregn" Content="Udregn" HorizontalAlignment="Center" Margin="0,314,0,0" VerticalAlignment="Top" Height="28" Width="116" Click="Udregn"/>
        <TextBox x:Name="SumBox" HorizontalAlignment="Center" Margin="0,347,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="116" TextChanged="SumBox_TextChanged" IsReadOnly="True"/>
        <Button x:Name="ButtonUndoIndtaegter" Content="Undo" HorizontalAlignment="Left" Margin="219,314,0,0" VerticalAlignment="Top" Click="ButtonUndoIndtaegter_Click"/>
        <Button x:Name="ButtonReset" Content="Reset" HorizontalAlignment="Center" Margin="0,382,0,0" VerticalAlignment="Top" Width="62" Click="ButtonReset_Click"/>
        <Button x:Name="ButtonUndoUdgifter" Content="Undo" HorizontalAlignment="Left" Margin="548,314,0,0" VerticalAlignment="Top" Click="ButtonUndoUdgifter_Click"/>
    </Grid>
</Window>
